<%- include('partials/header') %>

<main class="h-[100dvh] min-h-[100dvh] flex flex-col justify-between p-4 md:p-6 relative z-10 page-fade-transition overflow-hidden" id="main-content">
  
  <!-- Subtle Header (Hidden during final reveal to maximize focus) -->
  <header class="flex justify-between items-center w-full" id="teaser-header">
    <div class="text-[10px] font-mono tracking-widest text-gray-500 uppercase flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      <span id="header-status-text">SYSTEM SECURE</span>
    </div>
    
    <% if (settings.archive_enabled) { %>
      <a href="/projects" class="text-[10px] font-mono tracking-widest text-gray-500 hover:text-accent transition-colors uppercase">[ ARCHIVE ]</a>
    <% } %>
  </header>

  <!-- TEASER/COUNTDOWN SECTION -->
  <div class="my-auto py-4 md:py-6 flex flex-col items-center text-center max-w-4xl mx-auto w-full" id="countdown-section">
    <span class="text-[10px] md:text-xs font-mono tracking-[0.25em] text-accent uppercase mb-2 md:mb-3 opacity-80" id="teaser-label">NEXT PROJECT</span>
    
    <!-- Hero Text -->
    <h2 class="text-4xl md:text-6xl lg:text-7xl xl:text-8xl font-black tracking-tighter leading-[0.82] mb-3 md:mb-4 uppercase text-white select-none flex flex-col font-title" id="teaser-headline">
      <% 
        let words = settings.hero_text ? settings.hero_text.split(' ') : ['SOMETHING', 'BIG', 'IS COMING.'];
        let l1 = '', l2 = '', l3 = '';
        if (words.length === 1) {
          l1 = words[0];
        } else if (words.length === 2) {
          l1 = words[0]; l3 = words[1];
        } else if (words.length === 3) {
          l1 = words[0]; l2 = words[1]; l3 = words[2];
        } else {
          let third = Math.ceil(words.length / 3);
          l1 = words.slice(0, third).join(' ');
          l2 = words.slice(third, third*2).join(' ');
          l3 = words.slice(third*2).join(' ');
        }
      %>
      <span class="block overflow-hidden relative" style="<%= !l1 ? 'display:none' : '' %>"><span id="hl-line-1" class="block translate-y-[110%] opacity-0 filter blur-md transition-all duration-300"><%= l1 %></span></span>
      <span class="block overflow-hidden relative" style="<%= !l2 ? 'display:none' : '' %>"><span id="hl-line-2" class="block translate-y-[110%] opacity-0 filter blur-md transition-all duration-300"><%= l2 %></span></span>
      <span class="block overflow-hidden relative" style="<%= !l3 ? 'display:none' : '' %>"><span id="hl-line-3" class="block translate-y-[110%] opacity-0 filter blur-md transition-all duration-300 text-accent"><%= l3 %></span></span>
    </h2>
    
    <p class="text-[10px] md:text-xs font-mono tracking-[0.2em] text-gray-500 mb-6 md:mb-8 uppercase max-w-md opacity-0" id="teaser-desc">
      <%= settings.hero_subtitle %>
    </p>

    <!-- HUGE COUNTDOWN CONTAINER -->
    <div class="flex flex-row items-end justify-center gap-8 md:gap-14 lg:gap-20 mb-6 md:mb-8 w-full select-all" id="countdown-grid">
      <!-- Days -->
      <div class="flex flex-col items-center">
        <div class="flex flex-row gap-1 md:gap-2">
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-days-d1">0</span></div>
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-days-d2">0</span></div>
        </div>
        <span class="text-[9px] md:text-xs font-mono tracking-[0.2em] text-gray-500 uppercase mt-2">DAYS</span>
      </div>
      <!-- Hours -->
      <div class="flex flex-col items-center">
        <div class="flex flex-row gap-1 md:gap-2">
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-hours-d1">0</span></div>
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-hours-d2">0</span></div>
        </div>
        <span class="text-[9px] md:text-xs font-mono tracking-[0.2em] text-gray-500 uppercase mt-2">HOURS</span>
      </div>
      <!-- Minutes -->
      <div class="flex flex-col items-center">
        <div class="flex flex-row gap-1 md:gap-2">
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-minutes-d1">0</span></div>
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-white" id="val-minutes-d2">0</span></div>
        </div>
        <span class="text-[9px] md:text-xs font-mono tracking-[0.2em] text-gray-500 uppercase mt-2">MINUTES</span>
      </div>
      <!-- Seconds -->
      <div class="flex flex-col items-center">
        <div class="flex flex-row gap-1 md:gap-2">
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-accent" id="val-seconds-d1">0</span></div>
          <div class="countdown-num-wrapper text-5xl md:text-8xl lg:text-9xl"><span class="countdown-num text-accent" id="val-seconds-d2">0</span></div>
        </div>
        <span class="text-[9px] md:text-xs font-mono tracking-[0.2em] text-accent/70 uppercase mt-2">SECONDS</span>
      </div>
    </div>

    <span class="text-[10px] font-mono tracking-[0.3em] text-gray-600 uppercase" id="reveal-tag">UNTIL THE REVEAL</span>
  </div>

  <!-- REVEAL SCREEN (HIDDEN BY DEFAULT, SHOWN POST-LAUNCH) -->
  <div class="fixed inset-0 w-full h-[100dvh] flex flex-col items-center justify-center text-center hidden opacity-0 z-30 overflow-hidden bg-transparent" id="reveal-section">
    <% if (active_project && active_project.hero_image) { %>
      <div id="reveal-hero" class="absolute inset-0 w-full h-full -z-10 opacity-0 select-none pointer-events-none transition-transform duration-1000 ease-out" style="background: linear-gradient(to bottom, rgba(3,3,3,0.6) 0%, rgba(3,3,3,0.9) 100%), url('<%= active_project.hero_image %>') center/cover no-repeat;"></div>
    <% } %>

    <!-- Sequential Reveal Text Animation Layer -->
    <div id="reveal-seq-container" class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <% 
        let rWords = (active_project && active_project.reveal_text) ? active_project.reveal_text.split(' ') : ['THE', 'WAIT', 'IS OVER.'];
        let r1 = rWords[0] || 'THE';
        let r2 = rWords.length > 2 ? rWords.slice(1, -1).join(' ') : (rWords[1] || 'WAIT');
        let r3 = rWords.length > 2 ? rWords[rWords.length - 1] : (rWords[2] || 'IS OVER.');
        if (rWords.length === 2) { r1 = rWords[0]; r2 = ''; r3 = rWords[1]; }
      %>
      <div id="reveal-the" class="absolute text-4xl md:text-5xl font-black tracking-[0.4em] uppercase text-white opacity-0 select-none font-title"><%= r1 %></div>
      <div id="reveal-wait" class="absolute text-7xl md:text-9xl font-black uppercase text-accent opacity-0 select-none font-title"><%= r2 %></div>
      <div id="reveal-over" class="absolute text-8xl md:text-[7rem] lg:text-[8rem] font-black uppercase text-white opacity-0 select-none font-title"><%= r3 %></div>
    </div>
    
    <div id="reveal-project-details" class="flex flex-col items-center justify-center max-w-5xl px-6 w-full">
      <% if (active_project && active_project.logo) { %>
        <div id="reveal-logo-wrapper" class="opacity-0 select-none mb-8 relative group max-w-[280px] w-full">
          <!-- Ambient outline glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-accent/30 to-accent/5 rounded-sm blur-md opacity-70"></div>
          <!-- Tech border container -->
          <div class="relative px-6 py-4 bg-black/85 border border-white/10 rounded-sm shadow-2xl backdrop-blur-md flex items-center justify-center min-h-[120px]">
            <!-- Telemetry Corners -->
            <span class="absolute top-0 left-0 w-2 h-2 border-t border-l border-accent/60"></span>
            <span class="absolute top-0 right-0 w-2 h-2 border-t border-r border-accent/60"></span>
            <span class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-accent/60"></span>
            <span class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-accent/60"></span>
            
            <img id="reveal-logo" src="<%= active_project.logo %>" class="max-h-20 object-contain w-full" alt="Logo">
          </div>
        </div>
      <% } %>

      <h1 id="reveal-name" class="text-6xl md:text-8xl lg:text-[10rem] font-black tracking-tighter leading-none mb-6 uppercase text-white drop-shadow-[0_0_35px_rgba(var(--accent-rgb),0.15)] opacity-0 select-none font-title">
        <%= active_project ? active_project.name : 'PROJECT NOVA' %>
      </h1>

      <p id="reveal-tagline" class="text-xs md:text-sm font-mono tracking-[0.25em] text-gray-500 max-w-xl mb-14 uppercase opacity-0 select-none">
        <%= active_project ? active_project.tagline : 'A new kind of intelligence.' %>
      </p>

      <a id="reveal-cta" href="<%= (active_project && isValidPublicUrl(active_project.project_url)) ? active_project.project_url : '#' %>" target="_blank" class="accent-btn px-10 py-5 opacity-0 select-none">
        <%= active_project ? active_project.cta_text : 'ENTER PROJECT →' %>
      </a>
    </div>
  </div>

  <!-- 10 SECONDS CINEMATIC TAKEOVER ELEMENT -->
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 text-white hidden opacity-0 select-none pointer-events-none" id="ignition-overlay">
    <div class="text-center">
      <div id="ignition-number" class="text-[12rem] md:text-[20rem] font-black tracking-tight text-white leading-none scale-50 opacity-0 blur-md">10</div>
      <div class="text-xs font-mono tracking-[0.4em] text-accent uppercase mt-4">CRITICAL INITIATION STAGE</div>
    </div>
  </div>

  <!-- Pinpoint Center Glow -->
  <div id="pinpoint-glow" class="pinpoint-glow"></div>

  <!-- Footer Info -->
  <footer class="w-full text-center flex justify-between items-center text-[9px] font-mono tracking-wider text-gray-600 uppercase" id="teaser-footer-info">
    <div>// SECURE PORTAL 01</div>
    <div id="current-drop-id"><%= active_project ? `DEPLOY_TARGET: #${active_project.slug.toUpperCase()}` : 'DEPLOY_TARGET: STANDBY' %></div>
    <div>ALL RIGHTS RECLAIMED</div>
  </footer>

</main>

<script>
  // Setup project details injected by EJS
  const project = <%- active_project ? JSON.stringify(active_project) : 'null' %>;
  const previewState = "<%= preview || '' %>"; 

  // Helpers to handle number change animation (GPU-accelerated slide and opacity)
  function updateNumberElement(element, value) {
    const stringVal = String(value);
    if (element.innerText === stringVal) return;

    if (prefersReducedMotion) {
      element.innerText = stringVal;
      return;
    }

    gsap.timeline()
      .to(element, { 
        duration: 0.15, 
        yPercent: -100, 
        opacity: 0, 
        ease: "power2.in",
        onComplete: () => {
          element.innerText = stringVal;
          gsap.set(element, { yPercent: 100 });
        }
      })
      .to(element, { 
        duration: 0.3, 
        yPercent: 0, 
        opacity: 1, 
        ease: "power3.out",
        clearProps: "transform"
      });
  }

  // Cinematic audio synthesizer
  const playBeep = (freq = 440, duration = 0.1, type = 'sine', volume = 0.05) => {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(volume, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch(e){}
  };

  // Main UI elements
  const countdownSection = document.getElementById('countdown-section');
  const revealSection = document.getElementById('reveal-section');
  const teaserHeader = document.getElementById('teaser-header');
  const teaserFooter = document.getElementById('teaser-footer-info');
  const mainContent = document.getElementById('main-content');
  const ignitionOverlay = document.getElementById('ignition-overlay');
  const ignitionNumber = document.getElementById('ignition-number');

  // Split-digit countdown element refs
  const daysD1 = document.getElementById('val-days-d1');
  const daysD2 = document.getElementById('val-days-d2');
  const hoursD1 = document.getElementById('val-hours-d1');
  const hoursD2 = document.getElementById('val-hours-d2');
  const minsD1 = document.getElementById('val-minutes-d1');
  const minsD2 = document.getElementById('val-minutes-d2');
  const secsD1 = document.getElementById('val-seconds-d1');
  const secsD2 = document.getElementById('val-seconds-d2');

  function updateUnit(d1El, d2El, value) {
    const s = String(value).padStart(2, '0');
    updateNumberElement(d1El, parseInt(s[0]));
    updateNumberElement(d2El, parseInt(s[1]));
  }

  let currentIntensity = 'calm';

  // Determine Countdown Time
  let targetTime = project ? new Date(project.launch_at).getTime() : 0;
  let countdownActive = project && project.status === 'Coming Soon';

  // Override time if preview mode is requested
  if (previewState) {
    countdownActive = true;
    if (previewState === 'final_countdown') {
      targetTime = Date.now() + 10000; // 10 seconds from now
    } else if (previewState === 'reveal') {
      targetTime = Date.now() - 1000; // Passed
    } else if (previewState === 'live') {
      countdownActive = false; // Immediately live
    }
  }

  // Pre-load live state if already live
  if (project && project.status === 'Live' && !previewState) {
    countdownActive = false;
  }

  // Typographic Intro Sequence on Load
  window.addEventListener('DOMContentLoaded', () => {
    if (countdownActive) {
      if (prefersReducedMotion) {
        gsap.set(['#hl-line-1', '#hl-line-2', '#hl-line-3', '#teaser-desc', '#countdown-grid', '#reveal-tag'], { opacity: 1, y: 0, filter: 'none' });
        return;
      }
      const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
      tl.to('#hl-line-1', { duration: 1, y: 0, opacity: 1, filter: "blur(0px)", delay: 0.3 })
        .to('#hl-line-2', { duration: 1, y: 0, opacity: 1, filter: "blur(0px)" }, "-=0.75")
        .to('#hl-line-3', { duration: 1.2, y: 0, opacity: 1, filter: "blur(0px)" }, "-=0.75")
        .fromTo('#teaser-label', { opacity: 0, y: -10 }, { duration: 0.8, opacity: 0.8, y: 0 }, "-=0.8")
        .to('#teaser-desc', { duration: 0.8, opacity: 0.5, y: 0 }, "-=0.6")
        .fromTo(['#countdown-grid', '#reveal-tag'], { opacity: 0, y: 20 }, { duration: 1, opacity: 1, y: 0 }, "-=0.5");
    }
  });

  if (!countdownActive) {
    // Show launched state directly
    document.documentElement.classList.add('overflow-hidden');
    document.body.classList.add('overflow-hidden');
    countdownSection.classList.add('hidden');
    revealSection.classList.remove('hidden');
    revealSection.style.opacity = 1;
    document.getElementById('reveal-seq-container').classList.add('hidden');
    if (teaserHeader) teaserHeader.classList.add('hidden');
    
    // Animate reveal directly on load
    const logo = document.getElementById('reveal-logo-wrapper');
    if (logo) {
      gsap.fromTo(logo, { opacity: 0, scale: 0.95, filter: 'blur(10px)' }, { duration: 1.5, opacity: 1, scale: 1, filter: 'blur(0px)', ease: 'power3.out', delay: 0.2 });
    }
    const hero = document.getElementById('reveal-hero');
    if (hero) {
      gsap.fromTo(hero, { opacity: 0, scale: 1.05 }, { duration: 2, opacity: 0.25, scale: 1, ease: 'power3.out' });
    }
    gsap.fromTo('#reveal-name', { opacity: 0, scale: 0.95, filter: 'blur(10px)' }, { duration: 1.5, opacity: 1, scale: 1, filter: 'blur(0px)', ease: 'power3.out', delay: logo ? 0.4 : 0 });
    gsap.fromTo('#reveal-tagline', { opacity: 0 }, { duration: 1, opacity: 0.5, delay: logo ? 0.8 : 0.4 });
    gsap.fromTo('#reveal-cta', { opacity: 0, y: 15 }, { duration: 1.2, opacity: 1, y: 0, delay: logo ? 1.0 : 0.6, ease: 'power3.out' });
    gsap.fromTo('#glow-orb-inner', { scale: 0.001, opacity: 0 }, { duration: 2, scale: 1.1, opacity: 0.75, ease: 'power3.out' });
  } else {
    // Real-time Countdown Loop
    let ignitionTriggered = false;

    const timer = setInterval(() => {
      const now = Date.now();
      const diff = targetTime - now;

      if (diff <= 0) {
        clearInterval(timer);
        if (!ignitionTriggered) {
          triggerRevealSequence();
        }
        return;
      }

      // Break time units
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      // Perform fluid numeric update
      updateUnit(daysD1, daysD2, days);
      updateUnit(hoursD1, hoursD2, hours);
      updateUnit(minsD1, minsD2, mins);
      updateUnit(secsD1, secsD2, secs);

      // Visual escalations in the last 60 seconds
      if (diff <= 60000 && diff > 10000 && !prefersReducedMotion) {
        // 60s: Gentle scaling pulse on seconds ticks
        gsap.fromTo('#countdown-grid', { scale: 1 }, { scale: 1.02, duration: 0.35, yoyo: true, repeat: 1 });
        window.particleSpeedMultiplier = 1.3;
      }
      if (diff <= 45000 && diff > 10000 && !prefersReducedMotion) {
        // 45s: Speed up particle velocity
        window.particleSpeedMultiplier = 1.7;
      }
      if (diff <= 30000 && diff > 10000) {
        // 30s: Dim header, footer, microcopy to focus on timer
        gsap.to([teaserHeader, teaserFooter, '#teaser-label', '#teaser-desc', '#reveal-tag'], { duration: 0.8, opacity: 0.25 });
        if (!prefersReducedMotion) {
          gsap.to('#countdown-grid', { duration: 0.8, scale: 1.06 });
        }
      }
      if (diff <= 20000 && diff > 10000 && !prefersReducedMotion) {
        // 20s: Intensify atmosphere glow
        gsap.to('#glow-orb-inner', { duration: 0.8, scale: 1.25, opacity: 0.9 });
      }

      // 10s: Trigger overlay
      if (diff <= 10000) {
        clearInterval(timer);
        triggerCriticalCountdown(10);
      }
    }, 1000);

    // Critical 10 Seconds Final Sweep (Refined Cinematic Sequence)
    function triggerCriticalCountdown(count) {
      ignitionTriggered = true;
      ignitionOverlay.classList.remove('hidden');
      gsap.to(ignitionOverlay, { duration: 0.5, opacity: 1, pointerEvents: 'auto' });
      
      function tick() {
        if (count < 1) {
          gsap.to(ignitionOverlay, {
            duration: 0.4,
            opacity: 0,
            onComplete: () => {
              ignitionOverlay.classList.add('hidden');
              triggerRevealSequence();
            }
          });
          return;
        }

        // Play warning beeps (rise frequency on final ticks)
        const freq = count <= 3 ? 550 : (260 + (10 - count) * 35);
        playBeep(freq, count <= 3 ? 0.65 : 0.4, 'sine', 0.08);

        // Visual Escalations per Second
        if (count === 10) {
          gsap.to([teaserHeader, teaserFooter, '#teaser-label', '#teaser-desc', '#reveal-tag', '#countdown-glow'], { duration: 0.8, opacity: 0.1 });
        } else if (count === 9) {
          gsap.fromTo('#countdown-grid', { scale: 1.06 }, { scale: 1.1, duration: 0.35, yoyo: true, repeat: 1 });
        } else if (count === 8) {
          gsap.to('#glow-orb-inner', { duration: 0.8, scale: 1.35, opacity: 0.95 });
        } else if (count === 7) {
          window.targetCenterParticles = true; // pull particles to center
        } else if (count === 6) {
          gsap.to('#countdown-grid', { duration: 0.8, scale: 1.18 });
        } else if (count === 5) {
          gsap.to('#glow-orb-inner', { duration: 0.8, scale: 1.6, opacity: 1 });
        } else if (count === 4) {
          // Collapse glow toward center
          gsap.to('#glow-orb-inner', { duration: 0.8, scale: 0.25, opacity: 0.7 });
        } else if (count === 3) {
          // Timer fades out
          gsap.to(['#countdown-grid', '#countdown-glow'], { duration: 0.8, opacity: 0.05 });
        } else if (count === 2) {
          // Near black
          gsap.to(['#countdown-grid', '#glow-orb-inner'], { duration: 0.6, opacity: 0 });
          if (!prefersReducedMotion) {
            gsap.timeline()
              .to(ignitionOverlay, { duration: 0.05, opacity: 0 })
              .to(ignitionOverlay, { duration: 0.05, opacity: 1 });
          }
        } else if (count === 1) {
          // Freeze
          window.particleSpeedMultiplier = 0.001;
        }

        ignitionNumber.innerText = count;
        
        if (prefersReducedMotion) {
          gsap.set(ignitionNumber, { scale: 1, opacity: 1, filter: 'none' });
          setTimeout(() => { gsap.set(ignitionNumber, { opacity: 0 }); }, 800);
        } else {
          gsap.fromTo(ignitionNumber, 
            { scale: 1.15, opacity: 0, filter: 'blur(12px)' },
            { duration: 0.8, scale: 1, opacity: 1, filter: 'blur(0px)', ease: 'power2.out', onComplete: () => {
              gsap.to(ignitionNumber, { duration: 0.2, opacity: 0, scale: 1.25, delay: 0.05 });
            }}
          );
        }

        count--;
        setTimeout(tick, 1000);
      }
      tick();
    }

    // Zero-Hour Dramatic Cinematic Reveal Sequence
    function triggerRevealSequence() {
      // Prevent page scrolling during cinematic reveal
      document.documentElement.classList.add('overflow-hidden');
      document.body.classList.add('overflow-hidden');

      // 1. Clear out interface immediately
      countdownSection.classList.add('hidden');
      if (teaserHeader) teaserHeader.classList.add('hidden');
      if (teaserFooter) teaserFooter.classList.add('hidden');
      revealSection.classList.remove('hidden');
      revealSection.style.opacity = 1;

      window.particleSpeedMultiplier = 0.05;
      gsap.set('#glow-orb-inner', { scale: 0.001, opacity: 0 });

      // 2. Pinpoint light expands in absolute silence
      const pinpoint = document.getElementById('pinpoint-glow');
      pinpoint.style.display = 'block';
      
      gsap.timeline()
        .to(pinpoint, { duration: 1.2, scale: 1, opacity: 1, ease: 'power2.out' })
        .to(pinpoint, { 
          duration: 0.8, 
          scale: 120, 
          opacity: 0, 
          ease: 'power3.in',
          onComplete: () => {
            pinpoint.style.display = 'none';
            startTypographicSequence();
          }
        });

      function startTypographicSequence() {
        if (prefersReducedMotion) {
          const logo = document.getElementById('reveal-logo-wrapper');
          if (logo) gsap.set(logo, { opacity: 1, scale: 1, filter: 'none' });
          const hero = document.getElementById('reveal-hero');
          if (hero) gsap.set(hero, { opacity: 0.25, scale: 1 });
          gsap.set('#reveal-name', { opacity: 1, scale: 1, filter: 'none' });
          gsap.set('#reveal-tagline', { opacity: 0.5 });
          gsap.set('#reveal-cta', { opacity: 1 });
          document.getElementById('reveal-seq-container').classList.add('hidden');
          return;
        }

        // Expanded glow point
        gsap.to('#glow-orb-inner', { duration: 3, scale: 0.4, opacity: 0.6, ease: 'power2.out' });

        // "THE WAIT IS OVER" sentence sequence
        const tl = gsap.timeline({ defaults: { ease: 'cubic-bezier(.22,1,.36,1)' } });
        tl.to('#reveal-the', { duration: 0.6, opacity: 0.7, scale: 1, filter: 'blur(0px)' })
          .to('#reveal-the', { duration: 0.3, opacity: 0, scale: 0.9, delay: 0.2 })
          
          .to('#reveal-wait', { 
            duration: 0.6, 
            opacity: 1, 
            scale: 1.15, 
            filter: 'blur(0px)',
            onStart: () => {
              // Intensify central glow subtly
              gsap.to('#glow-orb-inner', { duration: 0.5, scale: 0.8, opacity: 0.8 });
            }
          })
          .to('#reveal-wait', { duration: 0.3, opacity: 0, scale: 0.9, delay: 0.2 })
          
          .to('#reveal-over', { 
            duration: 0.8, 
            opacity: 1, 
            scale: 1, 
            filter: 'blur(0px)',
            onStart: () => {
              // React entire environment
              gsap.to('#glow-orb-inner', { duration: 0.8, scale: 1.4, opacity: 0.9 });
              gsap.fromTo(mainContent, { scale: 0.98 }, { scale: 1, duration: 0.8 });
              playBeep(330, 0.8, 'sine', 0.08);
            }
          })
          .to('#reveal-over', { 
            duration: 0.5, 
            opacity: 0, 
            scale: 1.25, 
            filter: 'blur(10px)', 
            delay: 0.4, 
            onComplete: () => {
              document.getElementById('reveal-seq-container').classList.add('hidden');
              // Fade into darkness for a brief moment before project name reveal
              gsap.to('#glow-orb-inner', { duration: 0.4, scale: 0.001, opacity: 0 });
              setTimeout(revealProjectName, 800);
            }
          });
      }

      function revealProjectName() {
        // Small pinpoint appears again
        pinpoint.style.display = 'block';
        gsap.timeline()
          .fromTo(pinpoint, { scale: 0, opacity: 1 }, { duration: 0.8, scale: 1, ease: 'power2.out' })
          .to(pinpoint, {
            duration: 0.8,
            scale: 80,
            opacity: 0,
            ease: 'power3.in',
            onComplete: () => {
              pinpoint.style.display = 'none';
            }
          });

        // Project Name emerges from the light
        gsap.to('#glow-orb-inner', { duration: 3, scale: 1.1, opacity: 0.75, delay: 0.3 });
        
        const logo = document.getElementById('reveal-logo-wrapper');
        const hero = document.getElementById('reveal-hero');
        
        if (hero) {
          gsap.fromTo(hero, 
            { opacity: 0, scale: 1.15 }, 
            { duration: 2.5, opacity: 0.25, scale: 1.05, ease: 'power2.out' }
          );
        }

        const tlDetails = gsap.timeline({ defaults: { ease: 'cubic-bezier(.22,1,.36,1)' } });
        if (logo) {
          tlDetails.fromTo(logo,
            { scale: 0.65, opacity: 0, filter: 'blur(15px)' },
            { duration: 2, scale: 1, opacity: 1, filter: 'blur(0px)', delay: 0.4 }
          );
        }
        
        tlDetails.fromTo('#reveal-name',
          { scale: 0.65, opacity: 0, filter: 'blur(15px)' },
          { duration: 2, scale: 1, opacity: 1, filter: 'blur(0px)', delay: 0.4 },
          logo ? "-=1.8" : "-=0.4"
        )
        .to('#reveal-tagline', { duration: 0.8, opacity: 0.5 }, "-=0.8")
        .to('#reveal-cta', { duration: 1, opacity: 1 }, "-=0.6");
      }
    }
  }

  // CTA Enter Transition Effect
  const enterBtn = document.getElementById('reveal-cta');
  if (enterBtn) {
    enterBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetUrl = enterBtn.getAttribute('href');
      if (!targetUrl || targetUrl === '#') return;

      playBeep(880, 0.8, 'sine', 0.08);

      if (cursor && !prefersReducedMotion) {
        gsap.to(cursor, { duration: 0.5, scale: 40, opacity: 0, ease: 'power2.in' });
      }

      // Expand atmosphere glow out of screen via inner orb scaling
      gsap.to('#glow-orb-inner', { 
        duration: 0.6, 
        scale: 4,
        opacity: 1,
        ease: 'power3.in'
      });

      // Fade out body contents
      gsap.to(mainContent, {
        duration: 0.6,
        opacity: 0,
        y: -40,
        ease: 'power3.in',
        onComplete: () => {
          window.location.href = targetUrl;
        }
      });
    });
  }
</script>

