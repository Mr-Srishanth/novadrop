<%- include('partials/header') %>

<main class="min-h-screen flex items-center justify-center p-6 relative z-10">
  
  <div class="thin-border max-w-md w-full p-8 space-y-8 bg-black/60 relative overflow-hidden">
    <!-- Accent Line -->
    <div class="absolute top-0 left-0 w-full h-[2px] bg-accent"></div>

    <div class="text-center space-y-2">
      <span class="text-[9px] font-mono tracking-[0.3em] text-accent uppercase">SECURITY GATEWAY</span>
      <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white font-title">
        ADMIN ENTRY
      </h2>
      <p class="text-xs text-gray-500 font-mono uppercase tracking-widest">
        PROVIDE DEPLOYMENT AUTHORIZATION KEY
      </p>
    </div>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono p-3 text-center uppercase tracking-wider rounded-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-6">
      <div class="space-y-1">
        <label for="password" class="block text-[10px] font-mono text-gray-400 uppercase tracking-widest">Access Password</label>
        <input type="password" id="password" name="password" required placeholder="••••••••" class="w-full bg-black/60 border border-white/10 focus:border-accent focus:outline-none p-3.5 text-white font-mono text-sm tracking-widest rounded-sm">
      </div>

      <button type="submit" class="accent-btn w-full py-4 text-white">
        AUTHORIZE ACCESS
      </button>
    </form>
    
    <div class="text-center">
      <a href="/" class="text-[9px] font-mono tracking-widest text-gray-600 hover:text-gray-400 uppercase">[ BACK TO HOMEPAGE ]</a>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
