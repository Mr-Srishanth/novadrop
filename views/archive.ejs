<%- include('partials/header') %>

<main class="min-h-screen flex flex-col justify-between p-6 md:p-12 relative z-10 max-w-4xl mx-auto w-full">
  
  <header class="flex justify-between items-center w-full mb-16">
    <a href="/" class="text-[10px] font-mono tracking-widest text-gray-500 hover:text-accent transition-colors uppercase">[ BACK HOME ]</a>
    <span class="text-[10px] font-mono tracking-widest text-gray-500 uppercase">PROJECT ARCHIVE</span>
  </header>

  <div class="my-auto py-6 w-full space-y-12">
    <div class="border-b border-white/5 pb-4">
      <span class="text-xs font-mono tracking-widest text-accent uppercase">HISTORY</span>
      <h1 class="text-4xl md:text-5xl font-black uppercase text-white mt-1">PREVIOUS DROPS</h1>
    </div>

    <% if (projects.length === 0) { %>
      <div class="text-center py-12 text-sm text-gray-500 font-mono uppercase tracking-widest">
        NO PREVIOUS DEPLOYMENTS DETECTED.
      </div>
    <% } else { %>
      <div class="space-y-6">
        <% projects.forEach(p => { %>
          <div class="thin-border p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 group hover:border-white/20 transition-all duration-300">
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full" style="background-color: <%= p.accent_color %>"></span>
                <h3 class="text-xl md:text-2xl font-black uppercase text-white tracking-tight group-hover:text-accent transition-colors duration-300">
                  <%= p.name %>
                </h3>
                <span class="text-[9px] font-mono text-gray-500 bg-white/5 border border-white/10 px-2 py-0.5 rounded-sm">LAUNCHED</span>
              </div>
              <p class="text-sm text-gray-400 max-w-lg leading-relaxed"><%= p.tagline %></p>
            </div>
            
            <a href="<%= isValidPublicUrl(p.project_url) ? p.project_url : '#' %>" target="_blank" class="accent-btn flex-none px-6 py-3 border border-white/10 hover:border-accent text-xs font-bold uppercase tracking-widest text-white hover:text-accent transition-all duration-300 bg-white/[0.02]">
              ENTER PROJECT →
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <footer class="w-full text-center flex justify-between items-center text-[9px] font-mono tracking-wider text-gray-600 uppercase mt-16">
    <div>// SECURE ARCHIVE</div>
    <div>ALL RIGHTS RECLAIMED</div>
  </footer>

</main>

<%- include('partials/footer') %>
